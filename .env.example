# Apple signing and notarization credentials, read by `make build-macos` and
# `make notarize`. Copy this file to .env (gitignored) and fill in the values.
#
# APPLE_PASSWORD is an APP-SPECIFIC password generated at appleid.apple.com — not the
# account's own password, which the notary service refuses.

APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
APPLE_ID=you@example.com
APPLE_PASSWORD=app-specific-password-here
APPLE_TEAM_ID=TEAMID
