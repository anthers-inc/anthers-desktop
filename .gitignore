# The web app, resolved in by scripts/resolve-web.ts. A build artifact, never committed.
/web-dist/
/.web-dist.tar.gz

# Task worktrees and their scratch live inside the checkout, as they do in every
# Anthers repository: the branch, the directory and the task share one name, and
# `.tmp/` holds the screenshots and generated artifacts a task has to show.
/.worktrees/
/.tmp/

node_modules/

# Written by scripts/release-notes.sh; the release is their home, not the tree.
/release-notes-raw.md
/release-body.md

# Apple signing and notarization credentials, sourced by `make build-macos` and
# `make notarize`. `.env.example` is the committed template.
/.env
