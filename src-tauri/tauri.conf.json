{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Anthers",
	"version": "2026.10.0",
	"identifier": "org.anthers.desktop",
	"build": {
		"beforeDevCommand": "bun run scripts/resolve-web.ts",
		"devUrl": "http://localhost:3000",
		"frontendDist": "../web-dist",
		"beforeBuildCommand": "bun run scripts/resolve-web.ts"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Anthers",
				"width": 1600,
				"height": 1000,
				"minWidth": 1000,
				"minHeight": 700,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["anthers"]
			}
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNDMwMUMzRDIzOTVBMzMKUldReldqblN3d0ZEVEdHVk5CZVg3bkVrZmR1bHJySzBid1JheU5ocDF3bGdpL2RJRmpmbUtzWmYK",
			"endpoints": [
				"https://github.com/anthers-inc/anthers-desktop/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
		"publisher": "Anthers, Inc.",
		"copyright": "Copyright (c) 2026 Anthers, Inc.",
		"category": "DeveloperTool",
		"shortDescription": "Anthers \u2014 the creative garden, on your desktop",
		"longDescription": "The desktop app for Anthers \u2014 the whole platform in a native window, for readers and creators alike: browse, read, watch and play, publish and manage a catalog and posts. It is the Anthers experience you know from the web, not a separate tool. Keeps itself current: every release is signed and applied silently at restart.",
		"licenseFile": "../LICENSE.md",
		"linux": {
			"deb": {
				"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
			}
		},
		"icon": [
			"../icons/32x32.png",
			"../icons/128x128.png",
			"../icons/128x128@2x.png",
			"../icons/icon.icns",
			"../icons/icon.ico"
		],
		"macOS": {
			"entitlements": "entitlements.plist",
			"minimumSystemVersion": "10.15"
		}
	}
}
